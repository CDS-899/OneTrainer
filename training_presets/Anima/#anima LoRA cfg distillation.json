{
    "base_model_name": "circlestone-labs/Anima-Base-v1.0-Diffusers",
    "batch_size": 2,
    "learning_rate": 0.0001,
    "epochs": 20,
    "model_type": "ANIMA",
    "output_model_format": "KOHYA_LORA",
    "resolution": "512",
    "compile": true,
    "transformer": {
        "train": true,
        "weight_dtype": "INT_W8A8"
    },
    "text_encoder": {
        "train": false,
        "weight_dtype": "FLOAT_8"
    },
    "training_method": "LORA",
    "vae": {
        "weight_dtype": "FLOAT_32"
    },
    "train_dtype": "BFLOAT_16",
    "weight_dtype": "BFLOAT_16",
    "output_dtype": "BFLOAT_16",
    "timestep_distribution": "LOGIT_NORMAL",
    "lora_rank": 32,
    "lora_alpha": 32.0,
    "layer_filter": "attn1,attn2,ff",
    "layer_filter_preset": "attn-mlp",
    "quantization": {
        "layer_filter": "attn1,attn2,ff",
        "layer_filter_preset": "attn-mlp"
    },
    "learning_rate_warmup_steps": 100,
    "cfg_distillation": {
        "enabled": true,
        "prompts_path": "docs/fork/example_prompts.jsonl",
        "resolution": "",
        "steps": 20,
        "teacher_cfg": 4.5,
        "queries": 1,
        "negative_prompt": "",
        "seed": 42
    }
}
